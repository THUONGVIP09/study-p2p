@startuml
title UC04 - Sơ đồ lớp (Gửi lời mời)
class FriendClient {
  - ApiService api
  + sendRequest(targetId)
}
class ApiService {
  + post(url, body)
}
class FriendController {
  + createRequest(dto)
}
class FriendService {
  + create(requesterId, targetId): FriendRequest
}
class FriendRequest {
  + id: String
  + requesterId: String
  + targetId: String
  + status: Enum (PENDING, ACCEPTED, REJECTED)
}
FriendClient --> ApiService
FriendController --> FriendService
FriendService --> FriendRequest
@enduml