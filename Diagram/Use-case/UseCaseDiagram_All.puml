@startuml
title Sơ đồ Use Case tổng thể - Study P2P

left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF7FF
  BorderColor #2D6CDF
}

actor "Người dùng mới" as NewUser
actor "Người dùng" as User
actor "Người nhận lời mời" as Invitee
actor "Host phòng" as Host
actor "Người tham gia call" as Caller

rectangle "Hệ thống Study P2P" {
  usecase "UC01\nĐăng ký tài khoản" as UC01
  usecase "UC02\nĐăng nhập hệ thống" as UC02
  usecase "UC03\nTìm kiếm người dùng" as UC03
  usecase "UC04\nGửi lời mời\nkết bạn" as UC04
  usecase "UC05\nChấp nhận lời mời\nkết bạn" as UC05
  usecase "UC06\nTừ chối lời mời\nkết bạn" as UC06
  usecase "UC07\nXem danh sách bạn bè" as UC07
  usecase "UC08\nUnfriend (Hủy kết bạn)" as UC08
  usecase "UC09\nBlock người dùng" as UC09

  usecase "UC10\nTạo phòng học" as UC10
  usecase "UC11\nXem danh sách phòng" as UC11
  usecase "UC12\nTìm kiếm phòng" as UC12
  usecase "UC13\nTham gia phòng PUBLIC" as UC13
  usecase "UC14\nTham gia phòng PRIVATE\n(nhập passcode)" as UC14
  usecase "UC15\nCập nhật thông tin phòng" as UC15
  usecase "UC16\nXóa phòng" as UC16

  usecase "UC17\nTham gia cuộc gọi video" as UC17
  usecase "UC18\nChia sẻ màn hình" as UC18
  usecase "UC19\nXem danh sách người tham gia" as UC19
  usecase "UC20\nKick thành viên khỏi phòng" as UC20
  usecase "UC21\nRời khỏi cuộc gọi" as UC21

  usecase "UC22\nGửi tin nhắn chat" as UC22
  usecase "UC23\nXem lịch sử chat" as UC23

  usecase "UC24\nTạo task/nhắc nhở" as UC24
  usecase "UC25\nCập nhật trạng thái task" as UC25
  usecase "UC26\nXem thông báo" as UC26
}

