@startuml
title Use Case - Phòng học & Cuộc gọi
left to right direction
skinparam actorStyle awesome

actor "Người dùng" as User
actor "Host phòng" as Host
actor "Người tham gia call" as Caller

rectangle "Quản lý phòng" {
  usecase "UC10\nTạo phòng học" as UC10
  usecase "UC11\nXem danh sách phòng" as UC11
  usecase "UC12\nTìm kiếm phòng" as UC12
  usecase "UC13\nTham gia phòng PUBLIC" as UC13
  usecase "UC14\nTham gia phòng PRIVATE" as UC14
  usecase "UC15\nCập nhật thông tin phòng" as UC15
  usecase "UC16\nXóa phòng" as UC16
  usecase "UC20\nKick thành viên khỏi phòng" as UC20
}

rectangle "Cuộc gọi video" {
  usecase "UC17\nTham gia cuộc gọi video" as UC17
  usecase "UC18\nChia sẻ màn hình" as UC18
  usecase "UC19\nXem danh sách người tham gia" as UC19
  usecase "UC21\nRời khỏi cuộc gọi" as UC21
}

User --> UC11
User --> UC12
User --> UC13
User --> UC14
Host --> UC10
Host --> UC15
Host --> UC16
Host --> UC20
Caller --> UC17
Caller --> UC18
Caller --> UC19
Caller --> UC21

UC13 <|-- UC17 : <<include>>
UC17 <|-- UC18 : <<extend>>
UC17 <|-- UC19 : <<include>>
UC17 <|-- UC21 : <<extend>>

@enduml