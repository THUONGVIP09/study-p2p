@startuml
title UC17 - Trình tự Tham gia cuộc gọi video
actor "Người dùng (A)" as UserA
participant "Flutter UI (A)" as UIA
participant "WebSocketClient (A)" as WSA
participant "SignalingEndpoint (server)" as Signal
participant "WebSocketClient (B)" as WSB
participant "Flutter UI (B)" as UIB

UserA -> UIA: Join Call
UIA -> WSA: createOffer()
WSA -> Signal: send offer
Signal -> WSB: forward offer
WSB -> UIB: setRemoteDescription(offer)
WSB -> WSB: createAnswer()
WSB -> Signal: send answer
Signal -> WSA: forward answer
WSA -> UIA: setRemoteDescription(answer)

par ICE exchange
  WSA -> Signal: ICE candidate
  Signal -> WSB: forward ICE
|||
  WSB -> Signal: ICE candidate
  Signal -> WSA: forward ICE
end

UIA -> UIA: Start rendering remote/local streams
UIB -> UIB: Start rendering remote/local streams
@enduml